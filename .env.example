# ============ 公式 LaTeX 重建（OpenAI 兼容视觉模型）============
# 不配置 LLM_BASE_URL / LLM_API_KEY 时转换器完全离线，公式回退为 PDF 原图。

# 接口地址：需兼容 POST /chat/completions，末尾不带斜杠
LLM_BASE_URL=https://api.xiaomimimo.com/v1

# API Key；本地无鉴权服务可留空并设置 LLM_ALLOW_NO_KEY=true
LLM_API_KEY=sk-your-key

# 模型名（需支持图片输入）
LLM_MODEL=mimo-v2.6-flash

# 是否随请求发送公式区域截图：true=多模态识图；false=只发 PDF 文本层，适用于纯文本模型
LLM_VISION=true

# 单条公式请求的超时时间（毫秒）
LLM_TIMEOUT_MS=120000

# 并发请求数：越大越快，需确认服务端限流；公式之间并行执行
LLM_CONCURRENCY=3

# 单次转换最多调用多少个公式：0 表示不限，正整数可用于控制成本
LLM_MAX_IMAGES=0

# 本地无鉴权模型服务时设为 true，允许不带 API Key 调用（默认 false）
# LLM_ALLOW_NO_KEY=false

# ============ 行内混排公式转写 ============
# 公式与正文被 PDF 文本层打散时（如 "∑ ∑ j in K-dimensional space …"），
# 截图交给视觉模型重新排版为 $...$ 公式；设 false 可关闭。
MATH_LLM_ENABLED=true
# 单次转换最多转写多少行（0 表示不限，建议保留上限控制成本）
MATH_LLM_MAX_LINES=80

# ============ 中文翻译（生成 main_zh.md）============
# 默认关闭（false）：网页上勾选「同时生成中文版」或点击文档卡片的「翻译中文」按钮才会调用模型；
# CLI 用 --zh 开启。设为 true 则每次转换都自动翻译。
# 复用上面的 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL；
# 可用 TRANSLATE_MODEL / TRANSLATE_CONCURRENCY 单独指定模型与并发。
TRANSLATE_ENABLED=false

# ============ 其它可选开关 ============

# 规则无法关联图片时，把图注所在页面截图发给同一视觉模型定位并裁剪（默认 false）
FIGURE_LLM_ENABLED=false

# 额外写出可直接双击打开的 preview.html（默认 false，网页预览由 npm start 实时渲染）
PERSIST_PREVIEW=false
