# 可选：公式 LaTeX 重建使用的 OpenAI 兼容多模态模型
# 不配置时转换器完全离线运行，公式回退为 PDF 原图。
FORMULA_LLM_BASE_URL=https://api.xiaomimimo.com/v1
FORMULA_LLM_API_KEY=sk-your-key
FORMULA_LLM_MODEL=mimo-v2.6-flash
FORMULA_LLM_VISION=true
FORMULA_LLM_TIMEOUT_MS=120000
FORMULA_LLM_CONCURRENCY=3
# 0 表示不限制公式调用数量；设为正整数可限制成本
FORMULA_LLM_MAX_IMAGES=0

# 可选：规则无法关联图片时，将整页截图发送给上述视觉模型进行定位
FIGURE_LLM_ENABLED=false

# 可选：额外写出可直接双击打开的 preview.html（默认关闭，网页预览由服务端实时渲染）
PERSIST_PREVIEW=false
